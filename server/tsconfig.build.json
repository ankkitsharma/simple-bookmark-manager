{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./.vercel-build",
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "node",
    "noEmit": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2020"
  },
  "include": ["api/**/*", "src/**/*"],
  "exclude": ["node_modules", ".vercel-build"]
}
